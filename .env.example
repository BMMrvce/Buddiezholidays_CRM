# ── Supabase (use the SAME project as the Buddiez Holidays website) ──
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ── Agency identity ──
VITE_AGENCY_NAME=Buddiez Holidays
VITE_AGENCY_WHATSAPP=917204963703
VITE_AGENCY_PHONE=+917204963703
VITE_AGENCY_EMAIL=buddiezholidaysbengaluru@gmail.com

# ── Brevo transactional email (enables the "Email" buttons) ──
# NOTE: VITE_ vars are exposed in the browser bundle. OK for a private
# internal CRM; for production route email through a server endpoint.
VITE_BREVO_API_KEY=your-brevo-api-key
VITE_BREVO_SENDER_EMAIL=verified-sender@yourdomain.com
VITE_BREVO_SENDER_NAME=Buddiez Holidays

# ── Optional: mirror leads to Google Sheets ──
VITE_GOOGLE_SHEET_ID=your-google-sheet-id
VITE_GOOGLE_API_KEY=your-google-api-key
